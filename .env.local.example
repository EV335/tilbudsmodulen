# Kopier denne filen til ".env.local" og lim inn dine egne nøkler.
# Uten OPENAI_API_KEY bruker appen et lokalt estimat (fallback) i stedet for ekte AI-kall.

OPENAI_API_KEY=sk-mock-din-api-nokkel-her

# --- NextAuth (app/api/auth/[...nextauth]/route.ts) ---
# Generer med: openssl rand -base64 32
NEXTAUTH_SECRET=mock-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# --- Appens egen offentlige adresse ---
# ⚠️ MÅ settes ved deploy. Den brukes til å bygge betalingslenken
# (/betal/[token]) som legges i faktura-PDF-en og faktura-e-posten, og til
# Stripes success/cancel-URL-er. Uten den faller appen tilbake på
# NEXTAUTH_URL og deretter http://localhost:3000 — altså får hver eneste
# kunde en død lenke, uten at noe feiler synlig noe sted.
# Se appUrl() i lib/invoice.ts.
APP_URL=http://localhost:3000

# --- Supabase-adapter (lagrer brukere/sesjoner/verifikasjonstokens i Postgres) ---
# Finnes under Project Settings > API i Supabase-prosjektet ditt.
# NB: service_role-nøkkelen har full tilgang til databasen — server-side bruk kun, aldri i klientkode.
SUPABASE_URL=https://mock-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=mock-supabase-service-role-key

# --- E-post (magic link via EmailProvider) ---
# SMTP-opplysninger fra f.eks. Resend, Postmark, SendGrid eller eget SMTP-oppsett.
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=mock-smtp-bruker
EMAIL_SERVER_PASSWORD=mock-smtp-passord
EMAIL_FROM=TilbudsMaskinen <noreply@tilbudsmaskinen.no>

# --- Stripe (betaling og fakturering) ---
# Se docs/payments-setup.md for full oppskrift.
# Secret key: server-side kun (lib/stripe.ts). Publishable key er den eneste
# som er trygg i nettleseren — derfor NEXT_PUBLIC_-prefikset på den, og KUN den.
STRIPE_SECRET_KEY=sk_test_mock-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_mock-stripe-publishable-key

# Webhook-signering (app/api/webhooks/stripe/route.ts).
# NB: `stripe listen` har SIN EGEN secret, ulik den i Stripe-dashbordet.
# For lokal testing må denne matche den kjørende listen-sesjonen:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# I produksjon brukes secreten fra webhook-endepunktet i dashbordet.
STRIPE_WEBHOOK_SECRET=whsec_mock-webhook-secret
